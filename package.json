{
  "name": "orchestra",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "packageManager": "pnpm@10.17.1",
  "engines": {
    "node": ">=22.12.0 <23",
    "pnpm": "10.17.1"
  },
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test --concurrency=4 && pnpm test:architecture && pnpm test:plan",
    "test:architecture": "node --test tools/tests/*.test.mjs",
    "test:plan": "node plan/tools/verify-plan.mjs && node --test plan/tools/verify-plan.test.mjs",
    "lint": "turbo run lint --concurrency=4 && eslint *.mjs *.cjs tools/**/*.mjs vitest.config.ts",
    "typecheck": "turbo run typecheck && tsc --noEmit -p tsconfig.tools.json",
    "depcruise": "depcruise --config .dependency-cruiser.cjs apps packages",
    "dev": "turbo run dev --parallel",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.0.0",
    "@commitlint/config-conventional": "^20.0.0",
    "@eslint/js": "^9.0.0",
    "@types/node": "^22.0.0",
    "dependency-cruiser": "^18.0.0",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^10.0.0",
    "eslint-plugin-simple-import-sort": "^12.0.0",
    "globals": "^17.0.0",
    "husky": "^9.0.0",
    "lint-staged": "^16.0.0",
    "prettier": "^3.0.0",
    "turbo": "^2.0.0",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.0.0",
    "vitest": "^4.0.0"
  }
}
